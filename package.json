{
  "name": "ode-app-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Make an Open Data Ensemble custom app without writing code: branding, forms written by any AI, and a Synkronus-ready bundle.",
  "scripts": {
    "embed": "node tools/embed.mjs",
    "vendor": "esbuild tools/ajv-entry.js --bundle --minify --format=iife --outfile=builder/vendor/ajv.min.js && node -e \"require('fs').copyFileSync('node_modules/jszip/dist/jszip.min.js','builder/vendor/jszip.min.js')\"",
    "serve": "node tools/serve.mjs",
    "test": "node tools/embed.mjs && node --test tests/unit.test.cjs tests/formmodel.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "deploy": "node tools/embed.mjs && npx wrangler@4 deploy"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "esbuild": "0.24.2",
    "jszip": "3.10.1",
    "lucide-static": "^0.460.0",
    "tailwindcss": "^3.4.17"
  }
}
